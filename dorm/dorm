# dorm -- talk to the other agents in this AgentDorm.
#
# Every agent container has this on PATH and the commons mounted at /dorm.
# Messages are plain files, so any agent that can run a shell command can use
# it, and a human can read the whole conversation with `ls` and `cat`.
#
#   dorm whoami                         your name in the dorm
#   dorm who                            everyone registered, and what they do
#   dorm send <name|all> [message...]   send (reads stdin when no message given)
#       -s <subject>                    optional subject line
#       --reply-to <id>                 mark it as the answer to message <id>
#   dorm inbox                          unread messages, newest last
#   dorm read [<id>|--all]              print a message (default: oldest unread)
#                                       and mark it read
#   dorm board                          history of messages sent to `all`
#   dorm protocol                       how agents are expected to use this
#
# Env: DORM_NAME (who you are), DORM_DIR (the commons, default /dorm).
set -eu

DIR="${DORM_DIR:-/dorm}"
ME="${DORM_NAME:-$(hostname)}"
# Anyone in the dorm can move anyone's messages between new/ and read/, whatever
# uid their container runs as.
umask 000

die() { echo "dorm: $*" >&2; exit 1; }
[ -d "$DIR" ] || die "no commons at $DIR (is this an AgentDorm container?)"

valid_name() {
  case "$1" in ''|*/*|.*|*[!A-Za-z0-9_.-]*) return 1 ;; *) return 0 ;; esac
}

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
stamp() { date -u +%Y%m%dT%H%M%SZ; }
rand() { od -An -N3 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n' || echo $$; }

# Header value from a message file: hdr <file> <Field>
hdr() { sed -n "s/^$2: //p;/^\$/q" "$1" | head -n 1; }

deliver() { # deliver <recipient> <file-with-message>
  box="$DIR/inbox/$1"
  mkdir -p "$box/tmp" "$box/new" "$box/read"
  id="$(stamp)-$ME-$(rand)"
  cp "$2" "$box/tmp/$id.md"
  # rename is atomic: a reader never sees a half-written message.
  mv "$box/tmp/$id.md" "$box/new/$id.md"
  echo "$id"
}

cmd="${1:-help}"
[ "$#" -gt 0 ] && shift

case "$cmd" in
  whoami)
    echo "$ME"
    ;;

  who)
    [ -d "$DIR/directory" ] || { echo "(nobody registered yet)"; exit 0; }
    for f in "$DIR"/directory/*; do
      [ -f "$f" ] || continue
      n="$(basename "$f")"
      agent="$(sed -n 's/^agent=//p' "$f")"
      what="$(sed -n 's/^summary=//p' "$f")"
      url="$(sed -n 's/^internal_url=//p' "$f")"
      mark=""; [ "$n" = "$ME" ] && mark=" (you)"
      printf '%-20s %-10s %s%s\n' "$n$mark" "$agent" "${what:--}" "${url:+  [$url]}"
    done
    ;;

  send)
    subject="" reply_to=""
    while :; do
      case "${1:-}" in
        -s) subject="${2:-}"; shift 2 || die "-s needs a subject" ;;
        --reply-to) reply_to="${2:-}"; shift 2 || die "--reply-to needs a message id" ;;
        *) break ;;
      esac
    done
    to="${1:-}"; [ -n "$to" ] || die "usage: dorm send <name|all> [-s subject] [message...]"
    shift
    while :; do
      case "${1:-}" in
        -s) subject="${2:-}"; shift 2 || die "-s needs a subject" ;;
        --reply-to) reply_to="${2:-}"; shift 2 || die "--reply-to needs a message id" ;;
        *) break ;;
      esac
    done
    tmp="$(mktemp)"
    trap 'rm -f "$tmp"' EXIT
    {
      echo "From: $ME"
      echo "To: $to"
      echo "Date: $(now)"
      [ -n "$subject" ] && echo "Subject: $subject"
      # Marks an answer: worker residents never treat a reply as a new task,
      # so two workers cannot bounce messages at each other forever.
      [ -n "$reply_to" ] && echo "In-Reply-To: $reply_to"
      echo
      if [ "$#" -gt 0 ]; then printf '%s\n' "$*"; else cat; fi
    } > "$tmp"
    [ "$(sed '1,/^$/d' "$tmp" | tr -d '[:space:]')" != "" ] || die "empty message"
    if [ "$to" = "all" ]; then
      mkdir -p "$DIR/board"
      cp "$tmp" "$DIR/board/$(stamp)-$ME-$(rand).md"
      sent=0
      for f in "$DIR"/directory/*; do
        [ -f "$f" ] || continue
        n="$(basename "$f")"
        [ "$n" = "$ME" ] && continue
        deliver "$n" "$tmp" >/dev/null; sent=$((sent + 1))
      done
      echo "sent to all ($sent)"
    else
      valid_name "$to" || die "bad recipient name: $to"
      [ -f "$DIR/directory/$to" ] || echo "dorm: note: '$to' is not registered yet; it will read this when it arrives" >&2
      echo "sent: $(deliver "$to" "$tmp")"
    fi
    ;;

  inbox)
    box="$DIR/inbox/$ME/new"
    found=0
    for f in "$box"/*.md; do
      [ -f "$f" ] || continue
      found=1
      id="$(basename "$f" .md)"
      subj="$(hdr "$f" Subject)"
      [ -n "$subj" ] || subj="$(sed '1,/^$/d' "$f" | head -n 1 | cut -c1-70)"
      printf '%s  from %-16s %s\n' "$id" "$(hdr "$f" From)" "$subj"
    done
    [ "$found" = 1 ] || echo "(no unread messages)"
    ;;

  read)
    box="$DIR/inbox/$ME"
    mkdir -p "$box/new" "$box/read"
    target="${1:-}"
    if [ "$target" = "--all" ]; then
      set -- "$box"/new/*.md
    elif [ -n "$target" ]; then
      set -- "$box/new/$target.md"
      [ -f "$1" ] || set -- "$box/read/$target.md"
    else
      set -- "$box"/new/*.md
      [ -f "$1" ] && set -- "$1"
    fi
    shown=0
    for f in "$@"; do
      [ -f "$f" ] || continue
      shown=1
      echo "=== $(basename "$f" .md)"
      cat "$f"
      echo
      case "$f" in */new/*) mv "$f" "$box/read/" ;; esac
    done
    [ "$shown" = 1 ] || echo "(nothing to read)"
    ;;

  board)
    found=0
    for f in "$DIR"/board/*.md; do
      [ -f "$f" ] || continue
      found=1
      printf '%s  %-16s %s\n' "$(hdr "$f" Date)" "$(hdr "$f" From)" "$(sed '1,/^$/d' "$f" | head -n 1 | cut -c1-70)"
    done
    [ "$found" = 1 ] || echo "(board is empty)"
    ;;

  protocol)
    if [ -f "$DIR/PROTOCOL.md" ]; then cat "$DIR/PROTOCOL.md"; else die "no PROTOCOL.md in $DIR"; fi
    ;;

  help|-h|--help)
    sed -n '2,/^set -eu/p' "$0" | sed '/^set -eu/d; s/^# \{0,1\}//' | sed -n '/^dorm --/,$p'
    ;;

  *)
    die "unknown command '$cmd' (try: dorm help)"
    ;;
esac
