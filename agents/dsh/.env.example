# Copy to .env — docker compose reads it automatically.
DEEPSEEK_API_KEY=sk-your-key
# OpenRouter alternative: leave DEEPSEEK_API_KEY empty and set these instead.
OPENROUTER_API_KEY=
# Optional overrides; defaults shown.
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated model ids served by the provider.
#OPENROUTER_MODELS=deepseek/deepseek-chat-v3.1
# Host port for the web UI (container always serves 3080 internally).
DSH_PORT=3080
# Pin the harness version instead of `latest`, e.g. 0.1.0-rc.7
DSH_VERSION=latest
# Extra Host authorities the /api trust fence accepts, space separated.
# Loopback (localhost, 127.0.0.1) is already trusted.
DSH_TRUSTED_HOSTS=
