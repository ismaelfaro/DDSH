# Copy to .env — docker compose reads it automatically.
# Any one of these is enough; Hermes picks the provider you set with `hermes model`.
NOUS_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional OpenRouter overrides.
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#OPENROUTER_MODELS=deepseek/deepseek-chat-v3.1
# Host port for the dashboard (container always serves 9119 internally).
HERMES_PORT=9119
