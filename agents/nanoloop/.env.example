# Copy to .env or export in your shell. nanoLoop talks to models via OpenRouter.
OPENROUTER_API_KEY=
# Any tool-calling model slug on OpenRouter.
HARNESS_MODEL=openrouter/owl-alpha
# Optional: a cheaper model for the planner/builder/reviewer/qa/shipper subagents.
HARNESS_SUBAGENT_MODEL=
# Optional: fall back to this model if the primary keeps erroring.
HARNESS_FALLBACK_MODEL=
